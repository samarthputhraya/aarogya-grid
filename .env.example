# Aarogya Grid -- environment configuration
# Copy to .env.local and fill in. .env.local is gitignored.

# Gemini API key from https://aistudio.google.com/app/apikey
# Required for the last-mile capture layer (voice + register OCR).
GEMINI_API_KEY=

# Model IDs. Run `npx tsx scripts/list-models.ts` to see what your key can access.
GEMINI_MODEL=
GEMINI_MODEL_FAST=

# --- Optional, for the deployed build -------------------------------------
# Google Maps Platform JS API key (facility-level map). Restrict by HTTP referrer.
NEXT_PUBLIC_MAPS_API_KEY=

# GCP project for Vertex AI / BigQuery, once we move off the AI Studio key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
